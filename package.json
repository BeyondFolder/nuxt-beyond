{
  "name": "nuxt-beyond",
  "version": "1.0.0",
  "description": "An AI-first Nuxt 4 boilerplate for building SaaS products with chat, RAG, authentication, and billing",
  "author": "Raress96",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeyondFolder/nuxt-beyond"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "dev": "nuxt dev",
    "dev:remote": "CLOUDFLARE_ENV=remote nuxt dev --envName remote",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:ci": "eslint .",
    "lint": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "deploy": "NODE_OPTIONS=--max-old-space-size=8192 wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/vue": "^3.0.116",
    "@cloudflare/puppeteer": "^1.0.6",
    "@cloudflare/workers-types": "^4.20260316.1",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@libsql/client": "^0.17.0",
    "@noble/hashes": "^2.0.1",
    "@nuxt/content": "^3.12.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^0.13.2",
    "@nuxt/ui": "^4.5.1",
    "@nuxthub/core": "^0.10.7",
    "@nuxtjs/mdc": "^0.20.2",
    "@nuxtjs/seo": "^3.4.0",
    "@nuxtjs/turnstile": "^1.1.2",
    "@react-email/render": "^2.0.4",
    "@standard-schema/spec": "^1.1.0",
    "@unlok-co/nuxt-stripe": "^6.0.2",
    "@vueuse/nuxt": "^14.2.1",
    "ai": "^6.0.116",
    "ai-gateway-provider": "^3.1.1",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.3.1",
    "nuxt-auth-utils": "^0.5.29",
    "nuxt-og-image": "^5.1.13",
    "nuxt-seo-utils": "^7.0.19",
    "openai": "^6.29.0",
    "resend": "^6.9.3",
    "shiki-stream": "^0.1.4",
    "workers-ai-provider": "^3.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.73.0"
  },
  "overrides": {
    "unimport": "4.2.0"
  }
}
