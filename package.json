{
  "name": "nuxt-beyond",
  "version": "1.0.0",
  "description": "An AI-first Nuxt 4 boilerplate for building SaaS products with chat, RAG, authentication, and billing",
  "author": "BeyondFolder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeyondFolder/nuxt-beyond"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "dev": "nuxt dev",
    "dev:remote": "CLOUDFLARE_ENV=remote nuxt dev --envName remote",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint:ci": "eslint .",
    "lint": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "deploy": "NODE_OPTIONS=--max-old-space-size=8192 wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.140",
    "@ai-sdk/openai": "^3.0.139",
    "@ai-sdk/vue": "^3.0.325",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@google/genai": "^3.2.0",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.4.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.12",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/seo": "^5.3.16",
    "@nuxtjs/turnstile": "^1.1.3",
    "@polar-sh/nuxt": "^1.1.0",
    "@polar-sh/sdk": "^1.0.2",
    "@react-email/render": "^2.2.0",
    "@standard-schema/spec": "^1.1.0",
    "@takumi-rs/wasm": "^2.20.0",
    "@unlok-co/nuxt-stripe": "^6.0.2",
    "@vueuse/nuxt": "^15.0.0",
    "ai": "^6.0.325",
    "ai-gateway-provider": "^3.2.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-og-image": "^6.10.4",
    "nuxt-seo-utils": "^8.6.1",
    "resend": "^6.37.0",
    "shiki-stream": "^0.1.5",
    "workers-ai-provider": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@nuxt/eslint": "^1.17.0",
    "@takumi-rs/core": "^2.20.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.149.0"
  }
}
