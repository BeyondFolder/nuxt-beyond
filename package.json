    "@takumi-rs/wasm": "^1.8.7",
    "@unlok-co/nuxt-stripe": "^6.0.2",
    "@vueuse/nuxt": "^14.3.0",
    "ai": "^6.0.208",
    "ai-gateway-provider": "^3.1.3",
