# ===========================================
# NuxtBeyond Environment Variables
# ===========================================
#
# For local development: Copy this file to .env and fill in your values
#
# For Cloudflare deployment: Set these in the dashboard:
# - Build-time variables: Settings > Builds and deployments > Environment variables
# - Runtime variables: Settings > Variables and Secrets
# See README.md for detailed deployment instructions
#
# ===========================================

# Site URL for Nuxt SEO (sitemap, robots.txt, OG images)
# Required at BUILD TIME and RUNTIME for Cloudflare deployment
NUXT_SITE_URL=https://nuxtbeyond.com

# Optional: Environment type (production, staging, etc.)
# NUXT_SITE_ENV=production

# Public URL (used in runtime config)
# Required at BUILD TIME and RUNTIME for Cloudflare deployment
NUXT_PUBLIC_SITE_URL=https://nuxtbeyond.com

# ===========================================
# Authentication
# ===========================================

# Session password (must be at least 32 characters)
NUXT_SESSION_PASSWORD=your-secure-password-with-at-least-32-characters

# Google OAuth (https://console.cloud.google.com/apis/credentials)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ===========================================
# Email (Resend)
# ===========================================

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Required at BUILD TIME and RUNTIME for Cloudflare deployment
# Email addresses for system emails
# No-reply email for automated notifications
NO_REPLY_EMAIL=noreply@updates.yourdomain.com
# Required at BUILD TIME and RUNTIME for Cloudflare deployment
# Support email for feedback and inquiries
SUPPORT_EMAIL=support@yourdomain.com

# ===========================================
# Cloudflare / AI
# ===========================================

# Cloudflare account settings
CLOUDFLARE_ACCOUNT_ID=

# AutoRAG for knowledge base search
CLOUDFLARE_AUTO_RAG_API_TOKEN=
CLOUDFLARE_AUTO_RAG_ID=your-autorag-id

# AI Gateway for model routing
CLOUDFLARE_AI_GATEWAY_ID=your-ai-gateway-id

# ===========================================
# AI Model API Keys (optional, for different providers)
# ===========================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===========================================
# Stripe Billing
# ===========================================

# Stripe API keys (https://dashboard.stripe.com/apikeys)
# Note: Use NUXT_ prefix for automatic runtime config injection
NUXT_STRIPE_KEY=sk_test_your_secret_key
# Required at BUILD TIME and RUNTIME for Cloudflare deployment
NUXT_PUBLIC_STRIPE_KEY=pk_test_your_public_key

# Stripe webhook secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: promo code applied automatically at checkout
STRIPE_PROMO_CODE=

# ===========================================
# Turnstile (Cloudflare CAPTCHA)
# ===========================================

# Required at BUILD TIME and RUNTIME for Cloudflare deployment
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# ===========================================
# NuxtHub / Local Development
# ===========================================

# For local D1 database access via remote
NUXT_HUB_CLOUDFLARE_ACCOUNT_ID=
NUXT_HUB_CLOUDFLARE_DATABASE_ID=
NUXT_HUB_CLOUDFLARE_API_TOKEN=
